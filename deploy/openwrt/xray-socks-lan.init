#!/bin/sh /etc/rc.common
# =============================================================================
#  xray-socks-lan - a small SECOND xray instance.
#
#  Why: v2rayA keeps its SOCKS5 inbound on 127.0.0.1 only
#  (check with: netstat -lnpt | grep 20170). There is no package manager on
#  this router, so we reuse the already installed xray binary and start a
#  separate process that:
#      listens for SOCKS5 on 0.0.0.0:1080
#      and forwards everything to v2rayA's SOCKS5 on 127.0.0.1:20170.
#
#  The process is fully isolated: if it fails to start or crashes, the main
#  proxy (v2rayA) and the other LAN clients are not affected.
#
#  Single-instance guarantee: procd never starts a duplicate of its own
#  instance, but a MANUAL foreground run (`xray run -config ...`) would leave
#  an extra process holding port 1080. start_service() therefore kills any
#  leftover process that uses this config before starting its own.
#
#  Install:
#      readlink -f /proc/$(pidof xray)/exe      # find the binary path
#      cp xray-socks-lan.json /etc/xray-socks-lan.json
#      cp xray-socks-lan.init /etc/init.d/xray-socks-lan
#      chmod +x /etc/init.d/xray-socks-lan
#      vi /etc/init.d/xray-socks-lan            # adjust paths if needed
#      /etc/init.d/xray-socks-lan enable
#      /etc/init.d/xray-socks-lan start
#      logread -e xray-socks-lan
#
#  Verify:
#      netstat -lnpt | grep 1080                # expect 0.0.0.0:1080 or :::1080
#      ps w | grep xray                         # exactly ONE process per config
# =============================================================================

START=98
STOP=10
USE_PROCD=1

# >>> EDIT FOR YOUR SETUP <<<
# Path to the xray binary (find it with: readlink -f /proc/$(pidof xray)/exe).
XRAY_BIN="/usr/bin/xray"
# Config file for the second instance.
XRAY_CONF="/etc/xray-socks-lan.json"

# Echo PIDs of xray processes that run with our config file.
# We read /proc/<pid>/cmdline directly, so no pgrep/ps parsing is needed and
# the main v2rayA core (a different config) is never matched.
stray_pids() {
	for d in /proc/[0-9]*; do
		pid=${d#/proc/}
		[ -r "$d/cmdline" ] || continue
		cmd=$(tr '\0' ' ' < "$d/cmdline" 2>/dev/null)
		case "$cmd" in
			*xray*"$XRAY_CONF"*) echo "$pid" ;;
		esac
	done
}

kill_strays() {
	for pid in $(stray_pids); do
		logger -t xray-socks-lan "killing stray instance pid=$pid"
		kill "$pid" 2>/dev/null
	done
	# Give them a moment to release port 1080.
	sleep 1
}

start_service() {
	if [ ! -x "$XRAY_BIN" ]; then
		logger -t xray-socks-lan "binary not found or not executable: $XRAY_BIN"
		return 1
	fi
	if [ ! -f "$XRAY_CONF" ]; then
		logger -t xray-socks-lan "config not found: $XRAY_CONF"
		return 1
	fi

	# Never allow more than one instance for this config.
	kill_strays

	procd_open_instance
	procd_set_param command "$XRAY_BIN" run -config "$XRAY_CONF"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
