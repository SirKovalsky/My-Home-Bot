#!/bin/sh /etc/rc.common
# =============================================================================
#  xray-socks-lan — маленький ВТОРОЙ инстанс xray.
#
#  Зачем: v2rayA держит свой SOCKS5 только на 127.0.0.1 (проверяется
#  `netstat -lnpt | grep 20170`). Пакетов на роутере нет (opkg/apk отсутствуют),
#  поэтому берём уже установленный бинарник xray и поднимаем отдельный процесс,
#  который:
#      слушает SOCKS5 на 0.0.0.0:1080
#      и отправляет всё в SOCKS5 v2rayA на 127.0.0.1:20170.
#
#  Процесс полностью изолирован: если он не стартует или падает, основной прокси
#  (v2rayA) и остальные клиенты не затрагиваются.
#
#  Установка:
#      readlink -f /proc/$(pidof xray)/exe      # узнать путь к бинарнику
#      cp xray-socks-lan.json /etc/xray-socks-lan.json
#      cp xray-socks-lan.init /etc/init.d/xray-socks-lan
#      chmod +x /etc/init.d/xray-socks-lan
#      vi /etc/init.d/xray-socks-lan            # при необходимости поправьте пути
#      /etc/init.d/xray-socks-lan enable
#      /etc/init.d/xray-socks-lan start
#      logread -e xray-socks-lan
#
#  Проверка:
#      netstat -lnpt | grep 1080               # ждём 0.0.0.0:1080
# =============================================================================

START=98
STOP=10
USE_PROCD=1

# >>> ОТРЕДАКТИРУЙТЕ ПОД СЕБЯ <<<
# Путь к бинарнику xray (узнать: readlink -f /proc/$(pidof xray)/exe).
XRAY_BIN="/usr/bin/xray"
# Конфиг второго инстанса.
XRAY_CONF="/etc/xray-socks-lan.json"

start_service() {
	if [ ! -x "$XRAY_BIN" ]; then
		logger -t xray-socks-lan "binary not found or not executable: $XRAY_BIN"
		return 1
	fi
	if [ ! -f "$XRAY_CONF" ]; then
		logger -t xray-socks-lan "config not found: $XRAY_CONF"
		return 1
	fi

	procd_open_instance
	procd_set_param command "$XRAY_BIN" run -config "$XRAY_CONF"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
