#!/bin/sh /etc/rc.common
# =============================================================================
#  socks-lan - expose v2rayA's SOCKS5 (127.0.0.1:20170) to the LAN via socat.
#
#  Why: v2rayA listens on 127.0.0.1 by default, and enabling "Port Sharing" in
#  its panel is not desirable - there it is an alternative transparent-proxy
#  implementation that changes interception for ALL OpenWrt clients.
#  This script only port-forwards the existing SOCKS5 port, leaving the
#  transparent proxy, routing rules and other clients untouched.
#
#  Requires the socat package (install it first):
#      apk add socat            # newer OpenWrt
#      opkg update && opkg install socat
#
#  Single-instance guarantee: any leftover socat bound to our listen port
#  (e.g. from a manual foreground run) is killed before starting.
#
#  Install:
#      cp socks-lan.init /etc/init.d/socks-lan
#      chmod +x /etc/init.d/socks-lan
#      vi /etc/init.d/socks-lan # adjust LISTEN_ADDR / SOCKS_PORT if needed
#      /etc/init.d/socks-lan enable
#      /etc/init.d/socks-lan start
#      logread -e socks-lan
#
#  Verify:
#      netstat -lnpt | grep 20170
# =============================================================================

START=99
STOP=10
USE_PROCD=1

# >>> EDIT FOR YOUR SETUP <<<
# Listen address of the port forward:
#   - "0.0.0.0"   simplest, safe when OpenWrt sits BEHIND another router
#                 (its WAN is a private address, nothing is exposed outside).
#   - "<LAN IP>"  stricter: listen on the LAN interface only.
LISTEN_ADDR="0.0.0.0"
# SOCKS5 port from v2rayA: Setting -> Address and Ports -> "Port of SOCKS5".
SOCKS_PORT="20170"

# Echo PIDs of socat processes already listening on our port.
stray_pids() {
	for d in /proc/[0-9]*; do
		pid=${d#/proc/}
		[ -r "$d/cmdline" ] || continue
		cmd=$(tr '\0' ' ' < "$d/cmdline" 2>/dev/null)
		case "$cmd" in
			*socat*"TCP-LISTEN:${SOCKS_PORT}"*) echo "$pid" ;;
		esac
	done
}

kill_strays() {
	for pid in $(stray_pids); do
		logger -t socks-lan "killing stray socat pid=$pid"
		kill "$pid" 2>/dev/null
	done
	sleep 1
}

start_service() {
	if ! command -v socat >/dev/null 2>&1; then
		logger -t socks-lan "socat not found; install it first (apk add socat / opkg install socat)"
		return 1
	fi

	kill_strays

	procd_open_instance
	procd_set_param command /usr/bin/socat \
		"TCP-LISTEN:${SOCKS_PORT},bind=${LISTEN_ADDR},fork,reuseaddr" \
		"TCP:127.0.0.1:${SOCKS_PORT}"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
