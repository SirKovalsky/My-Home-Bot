[Unit]
Description=Telegram torrent bot (Transmission autoloader)
Documentation=https://github.com/SirKovalsky/My-Home-Bot
# The network must be up before we start.
Wants=network-online.target
After=network-online.target

# Uncomment if Transmission is installed from SynoCommunity, so the bot
# starts after the Transmission daemon:
#After=transmission.service

[Service]
Type=simple
# User the bot runs as. root is the simplest; sc-transmission also works
# if it owns the project directory.
User=__BOT_USER__
WorkingDirectory=__INSTALL_DIR__

# Unicode/buffering - keeps logs and torrent names tidy.
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=LC_ALL=C.UTF-8

ExecStart=__INSTALL_DIR__/.venv/bin/python __INSTALL_DIR__/bot.py

# Restart on failure (proxy/network/Transmission may flap).
Restart=on-failure
RestartSec=15

# Logs go to a file (LOG_FILE in .env) and to the journal:
#   journalctl -u torrent-bot -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
