# =============================================================================
#  torrent-bot — пример конфигурации.
#  Скопируйте в .env и заполните:  cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Telegram
# -----------------------------------------------------------------------------
# Токен у @BotFather
TELEGRAM_BOT_TOKEN=123456:AAEEexample-token-replace-me

# Кто имеет право пользоваться ботом — список Telegram user id через запятую.
# Пусто = разрешено всем (НЕ рекомендуется, бот умеет качать в вашу сеть!).
ALLOWED_USER_IDS=111111111,222222222

# -----------------------------------------------------------------------------
# Прокси на OpenWrt (SOCKS5 или HTTP) — ТОЛЬКО для трекеров!
# -----------------------------------------------------------------------------
# ВАЖНО: только этот адрес используется в proxies={...} для rutracker/kinozal.
# Схема socks5h обязательна: DNS резолвится на стороне OpenWrt, а не на Xpenology.
PROXY_URL=socks5h://192.168.1.2:1080
# Если на OpenWrt развёрнут HTTP-прокси, укажите socks5h -> http и порт:
# PROXY_URL=http://192.168.1.2:8118

# Ходить к трекерам НАПРЯМУЮ (без прокси): PROXY_URL=direct
# Нужно, если трекеры с этого NAS доступны, а exit-IP прокси они банят (403).
# PROXY_URL=direct

# Таймаут (сек) на запросы к трекерам через прокси.
PROXY_TIMEOUT=30

# Прокси ТОЛЬКО для Telegram Bot API (api.telegram.org). Пусто = напрямую.
# Нужен, если провайдер блокирует Telegram. Используйте HTTP-прокси:
# наш xray-socks-lan отдаёт HTTP на порту 1081 (SOCKS — на 1080).
# SOCKS-прокси здесь не поддерживается без доп. пакета aiohttp-socks.
# Пример: TELEGRAM_PROXY_URL=http://192.168.1.2:1081
TELEGRAM_PROXY_URL=

# -----------------------------------------------------------------------------
# Transmission RPC (localhost на Xpenology) — БЕЗ прокси!
# -----------------------------------------------------------------------------
TRANSMISSION_HOST=127.0.0.1
TRANSMISSION_PORT=9091
TRANSMISSION_USER=
TRANSMISSION_PASSWORD=
TRANSMISSION_RPC_PATH=/transmission/rpc
TRANSMISSION_PROTOCOL=http
TRANSMISSION_TIMEOUT=30

# -----------------------------------------------------------------------------
# Папки загрузки (роутинг по категориям, пути Plex)
# -----------------------------------------------------------------------------
# Бот определяет категорию автоматически, но НЕ применяет её молча —
# он показывает вариант кнопкой и ждёт подтверждения от пользователя.
DOWNLOAD_DIR_MOVIES=/volume2/downloads2/Movies
DOWNLOAD_DIR_SERIES=/volume2/downloads2/Series
DOWNLOAD_DIR_ANIME=/volume2/downloads2/Anime
DOWNLOAD_DIR_AUDIOBOOKS=/volume2/downloads2/Audiobooks
DOWNLOAD_DIR_MUSIC=/volume2/downloads2/Music
DOWNLOAD_DIR_SOFT=/volume2/downloads2/Soft
# Запасной путь, если категорию определить не удалось.
DOWNLOAD_DIR_DEFAULT=/volume2/downloads2/Movies

# Сколько секунд хранить торрент в ожидании подтверждения папки.
CONFIRM_TTL=3600

# Ключевые слова для автоопределения категории (через запятую, регистр не важен).
# Логика для аниме: аниме + признаки сериальности -> Anime,
#                  аниме без них (полнометражное) -> Movies.
MOVIES_KEYWORDS=фильм,фильмы,кино,movie,movies,film,films,мультфильм,мультфильмы,полнометражный,полнометражка,полнометражное,cartoon,blu-ray,bdremux
SERIES_KEYWORDS=сериал,сериалы,сезон,season,серии,серия,эпизод,episode,tv-shows,tvshow,дорама
ANIME_KEYWORDS=аниме,anime,аниме-сериал,анимесериал,ova,ona,аниме-сезон,anilibria,anidub,animedia,anistar,animevost,kansai,kraken,studioband,jisedai,amik
AUDIOBOOKS_KEYWORDS=аудиокнига,аудиокниги,аудиокниг,audiobook,audiobooks,аудиоспектакль,аудиосериал
MUSIC_KEYWORDS=flac,mp3,lossless,discography,дискография,саундтрек,soundtrack,ost,альбом,album,музыка,music
SOFT_KEYWORDS=софт,software,программа,программы,portable,keygen,кряк,crack,активатор,лицензия,windows,office,adobe,macos,driver,драйвер,антивирус,antivirus
# Маркеры многосерийности (для отличия сериала/аниме от полнометражки).
EPISODE_MARKERS=сезон,season,серии,серия,эпизод,episode,выпуск

# -----------------------------------------------------------------------------
# Учётные данные трекеров
# -----------------------------------------------------------------------------
RUTRACKER_LOGIN=
RUTRACKER_PASSWORD=

KINOZAL_LOGIN=
KINOZAL_PASSWORD=

# -----------------------------------------------------------------------------
# Файлы состояния
# -----------------------------------------------------------------------------
# Куда сохранять cookies/сессии трекеров (чтобы не логиниться каждый раз).
COOKIES_FILE=cookies.pickle
COOKIES_TTL_DAYS=14
LOG_FILE=torrent-bot.log
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Уведомления
# -----------------------------------------------------------------------------
# Интервал опроса Transmission для уведомлений о завершении загрузки (сек).
POLL_INTERVAL=15
# Присылать уведомление о завершении загрузки.
NOTIFY_ON_COMPLETE=true

# Реальный браузерный User-Agent — rutracker/kinozal банят дефолтные UA.
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
